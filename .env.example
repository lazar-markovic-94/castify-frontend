# =============================================================================
# Castify Frontend Environment Variables - EXAMPLE
# =============================================================================
# This is a template file. Copy the appropriate environment file for your use:
#
# FOR LOCAL DEVELOPMENT (connecting to local backend):
#   cp .env.local .env
#   OR just use .env.local directly (Vite loads it automatically)
#
# FOR DEV SERVER DEPLOYMENT (connecting to remote dev backend):
#   cp .env.development .env
#
# FOR PRODUCTION DEPLOYMENT (connecting to production backend):
#   cp .env.production .env
#
# NEVER commit .env or .env.local to version control!
# =============================================================================

# API Configuration (REQUIRED)
# The base URL for the backend API
# - Local Development: http://localhost:8080
# - Dev/Production Server: https://castify-alpha.duckdns.org
VITE_API_BASE_URL=http://localhost:8080

# Debug Mode (OPTIONAL)
# Enable debug logging in the browser console
# Set to 'true' for development, 'false' for production
VITE_DEBUG=true

# Application Name (OPTIONAL)
# The name of the application (used in titles, etc.)
VITE_APP_NAME=Castify

# =============================================================================
# Environment File Priority (Vite):
# 1. .env.local (highest priority, local overrides, not tracked in git)
# 2. .env.development / .env.production (mode-specific)
# 3. .env (general defaults, not tracked in git)
# 4. .env.example (template only, tracked in git)
#
# Notes:
# - All variables prefixed with VITE_ are exposed to the client
# - Do NOT store secrets or sensitive data in environment variables
# - The application will fail to start if required variables are missing
# =============================================================================
