# =============================================================================
# Castify Frontend Environment Variables
# =============================================================================
# Copy this file to .env and fill in the actual values
# NEVER commit .env files to version control
# =============================================================================

# API Configuration (REQUIRED)
# The base URL for the backend API
# Development: http://localhost:8080
# Production: https://api.castify.com
VITE_API_BASE_URL=http://localhost:8080

# Debug Mode (OPTIONAL)
# Enable debug logging in the browser console
# Set to 'true' for development, 'false' for production
VITE_DEBUG=false

# Application Name (OPTIONAL)
# The name of the application (used in titles, etc.)
VITE_APP_NAME=Castify

# =============================================================================
# Notes:
# - All variables prefixed with VITE_ are exposed to the client
# - Do NOT store secrets or sensitive data in environment variables
# - The application will fail to start if required variables are missing
# =============================================================================
