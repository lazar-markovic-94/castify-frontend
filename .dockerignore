# =============================================================================
# Frontend .dockerignore
# Excludes files from Docker build context to speed up builds
# =============================================================================

# Dependencies (will be installed in Dockerfile)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
package-lock.json

# Build output (will be created during build)
dist/
build/
.vite/

# IDE files
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
*.log

# Git
.git/
.gitignore
.gitattributes

# Environment files
.env
.env.*
!.env.example

# Test files
**/__tests__/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
coverage/
.nyc_output/

# Documentation
*.md
!README.md
docs/

# Development tools
.eslintrc*
.prettierrc*
tsconfig*.json
vite.config.ts

# Docker files themselves
Dockerfile*
docker-compose*.yml
.dockerignore
nginx.conf

# CI/CD files
.github/
.gitlab-ci.yml
Jenkinsfile

# Cache and temporary files
.cache/
.temp/
*.tmp
*.cache

# Storybook
.storybook/
storybook-static/

# Backup files
*.bak
*.backup
*.old

# Archives
*.zip
*.tar
*.gz

# Source maps (large files, not needed in production)
*.map

# Public directory (will be copied during build)
# Uncomment if you want to exclude specific public files
# public/
